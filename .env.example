# Copy to .env (or set these in the parent hack-p1/.env). .env is gitignored.

# Azure Postgres (or any Postgres). Driver suffix added automatically if omitted.
DATABASE_URL=postgresql://user:password@host:5432/call_radar?sslmode=require

# Azure OpenAI — analysis LLM (gpt-5-mini)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<key>
AZURE_OPENAI_API_VERSION=2025-04-01-preview
GPT_DEPLOYMENT=gpt-5-mini

# Local STT model (faster-whisper). tiny.en | base.en | small.en
WHISPER_MODEL=base.en
